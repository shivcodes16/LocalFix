# ==============================
# LocalFix Server Environment Variables
# Copy this file to .env and fill in real values.
# Never commit the real .env file.
# ==============================

# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/localfix

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_DAYS=7

# Cloudinary (image uploads). If left blank, image uploads gracefully
# fall back to storing whatever URL/base64 the client already has.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Nodemailer (email notifications). If left blank, emails are logged
# to the console instead of actually being sent, so the app keeps working.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="LocalFix <no-reply@localfix.app>"

# AI (OpenAI-compatible). If left blank, AI features fall back to a
# lightweight keyword-based classifier and simple text summarizer.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Maps / Geocoding (optional). If left blank, the app falls back
# to plain lat/lng distance search entered manually by users.
GOOGLE_MAPS_API_KEY=
